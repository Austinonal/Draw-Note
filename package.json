{
  "name": "draw-note",
  "version": "0.1.0",
  "private": true,
  "description": "DrawNote: a mobile-first notebook and painting app (notes + pro painting in one)",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-ocr.mjs",
    "dev": "vite --host",
    "prebuild": "node scripts/copy-ocr.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "android:init": "npm run build && npx cap add android && npx cap sync android",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/tha": "1.0.0",
    "lucide-react": "^1.70.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.296",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "7.4.3",
    "@capacitor/cli": "7.4.3",
    "@capacitor/core": "7.4.3",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "typescript": "5.9.2",
    "vite": "7.1.5",
    "vitest": "3.2.4"
  }
}
